{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project-state-v2.schema.json",
  "title": "Local AI Video Factory durable state v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "revision", "state", "updated_at", "run", "gates", "approvals", "revision_request", "last_error", "events"],
  "properties": {
    "schema_version": {"const": 2},
    "project_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"},
    "revision": {"type": "integer", "minimum": 0},
    "state": {"enum": ["NEW", "PHASE1_RUNNING", "GATE1_REVIEW", "PHASE2_PENDING", "PHASE2_RUNNING", "GATE2_REVIEW", "REVISIONS_RUNNING", "PHASE3_READY", "PHASE3_RUNNING", "FINAL_REVIEW", "COMPLETED", "FAILED_RECOVERABLE"]},
    "updated_at": {"type": "string", "format": "date-time"},
    "run": {"type": ["object", "null"]},
    "gates": {"type": "object"},
    "approvals": {"type": "array"},
    "revision_request": {"type": ["object", "null"]},
    "last_error": {"type": ["object", "null"]},
    "events": {"type": "array", "minItems": 1}
  }
}
