{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gate-manifest-v1.schema.json",
  "title": "Content-bound gate manifest envelope",
  "type": "object",
  "required": ["schema_version", "kind", "project_id", "revision"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"enum": ["gate1", "gate2", "final"]},
    "project_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"},
    "revision": {"type": "integer", "minimum": 1},
    "cross_segment_take_analysis": {"$ref": "#/$defs/artifact"}
  },
  "allOf": [
    {
      "if": {"properties": {"kind": {"const": "gate1"}}},
      "then": {"required": ["cross_segment_take_analysis"]}
    }
  ],
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "sha256", "size_bytes"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 1}
      }
    }
  }
}
