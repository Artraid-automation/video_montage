    {
      "id": "u0012",
      "start_s": 44.52,
      "end_s": 48.32,
      "text": "который тоже нужно внезапно изучать, практиковать.",
      "word_ids": [
        "w000097",
        "w000098",
        "w000099",
        "w000100",
        "w000101",
        "w000102"
      ],
      "decision": "keep",
      "reason": null,
      "take_group": null
    },
    {
      "id": "u0013",
      "start_s": 48.48,
      "end_s": 53.38,
      "text": "Большинство людей не строят, они балуются, берут первое,",
      "word_ids": [
        "w000103",
        "w000104",
        "w000105",
        "w000106",
        "w000107",
        "w000108",
        "w000109",
        "w000110"
      ],
      "decision": "keep",
      "reason": null,
      "take_group": null
    },
    {
      "id": "u0014",
      "start_s": 53.38,
      "end_s": 59.04,
      "text": "второе, третье направление в каждом, как только встречают",
      "word_ids": [
        "w000111",
        "w000112",
        "w000113",
        "w000114",
        "w000115",
        "w000116",
        "w000117",
        "w000118"
      ],
      "decision": "keep",
      "reason": null,
      "take_group": null
