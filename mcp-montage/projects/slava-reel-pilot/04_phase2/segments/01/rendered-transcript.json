      "reason": null,
      "take_group": null
    },
    {
      "id": "u0016",
      "start_s": 62.36,
      "end_s": 67.72,
      "text": "Вместо того, чтобы добежать до результата и без понимания,",
      "word_ids": [
        "w000126",
        "w000127",
        "w000128",
        "w000129",
        "w000130",
        "w000131",
        "w000132",
        "w000133",
        "w000134"
      ],
      "decision": "keep",
      "reason": null,
      "take_group": null
    },
    {
      "id": "u0017",
      "start_s": 67.72,
      "end_s": 72.9,
      "text": "что эти трудности, они возникнут в любом,",
      "word_ids": [
        "w000135",
        "w000136",
        "w000137",
        "w000138",
        "w000139",
        "w000140",
        "w000141"
      ],
      "decision": "keep",
      "reason": null,
      "take_group": null
    },
    {
      "id": "u0018",
      "start_s": 73.04,
      "end_s": 76.62,
      "text": "где и последнее большинство не растут через провалы,",
