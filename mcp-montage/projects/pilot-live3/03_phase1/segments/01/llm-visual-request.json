  "segment_id": "01",
  "keep_blocks": [
    {
      "id": "u0001p1",
      "start_s": 6.94,
      "end_s": 11.81,
      "text": "звонки Какой-то чел на своем мобильном телефоне"
    },
    {
      "id": "u0001p2",
      "start_s": 11.84,
      "end_s": 17.61,
      "text": "сделал проект CRM-системы которая слушает звонки которые происходят на"
    },
    {
      "id": "u0001p3",
      "start_s": 19.49,
      "end_s": 21.35,
      "text": "еще в мессенджерах"
    },
    {
      "id": "u0003p1",
      "start_s": 22.59,
      "end_s": 28.21,
      "text": "просто на диктофон встроенный в телефон потом транскрибирует эти звонки локально"
    },
    {
      "id": "u0003p2",
      "start_s": 28.69,
      "end_s": 29.96,
      "text": "нужный"
    },
    {
      "id": "u0003p3",
      "start_s": 30.09,
      "end_s": 31.71,
      "text": "как достаточно"
    },
    {
      "id": "u0003p4",
      "start_s": 32.34,
      "end_s": 37.76,
      "text": "тем не менее работает 10-минутный звонок как заявлено расшифровывает за"
    },
    {
      "id": "u0003p5",
      "start_s": 37.89,
      "end_s": 45.91,
      "text": "6,5 минут либо на другой модели транскрибации за 17 минут Ну понятное дело это все показатели настраиваемые"
    },
    {
      "id": "u0003p6",
      "start_s": 46.34,
      "end_s": 47.76,
      "text": "А потом локальная"
    },
    {
      "id": "u0003p7",
      "start_s": 47.94,
      "end_s": 50.11,
      "text": "моделика ИИ раскладывает"
    },
    {
      "id": "u0003p8",
      "start_s": 51.94,
      "end_s": 55.56,
      "text": "создает маркдаун-файлы для обсидиана"
    },
    {
      "id": "u0003p9",
      "start_s": 56.04,
      "end_s": 58.81,
      "text": "Короче отбрасывая техничку просто сохраняет"
    },
    {
      "id": "u0003p10",
      "start_s": 58.89,
      "end_s": 60.36,
      "text": "очень... просто"
    },
    {
      "id": "u0003p11",
      "start_s": 61.09,
      "end_s": 66.71,
      "text": "локально на телефоне При этом какие-то дукапы и облачные загрузки"
    },
    {
      "id": "u0007",
      "start_s": 67.99,
      "end_s": 70.27,
      "text": "отключены у этого проекта"
    },
    {
      "id": "u0008p1",
      "start_s": 72.79,
      "end_s": 76.26,
      "text": "Я не так давно смотрел локальную"
    },
    {
      "id": "u0008p2",
      "start_s": 76.44,
      "end_s": 82.06,
      "text": "нейронку на телефон который даже сама какой-то сервис типа"
    },
    {
      "id": "u0008p3",
      "start_s": 82.29,
      "end_s": 84.81,
      "text": "достаточно тупенько но тем не менее может"
    },
    {
      "id": "u0008p4",
      "start_s": 85.59,
      "end_s": 86.25,
      "text": "саску"
    },
    {
      "id": "u0009",
      "start_s": 86.87,
      "end_s": 88.43,
      "text": "Тут да мы стапим"
    },
    {
      "id": "u0010p1",
      "start_s": 89.41,
      "end_s": 90.11,
      "text": "уточнение"
    },
    {
      "id": "u0010p2",
      "start_s": 90.64,
      "end_s": 91.56,
      "text": "звездочку"
    },
    {
      "id": "u0010p3",
      "start_s": 91.64,
      "end_s": 93.56,
      "text": "телефон должен быть достаточно"
    },
    {
      "id": "u0010p4",
      "start_s": 94.14,
      "end_s": 100.76,
      "text": "Anyway со временем мы будем видеть все больше и все более умные локальные"
    },
    {
      "id": "u0010p5",
      "start_s": 101.74,
      "end_s": 104.46,
      "text": "опускаться там вплоть до часов или еще более"
    },
    {
      "id": "u0010p6",
      "start_s": 104.89,
      "end_s": 108.46,
      "text": "девайсов Работать без зависимости от какого-то"
    },
    {
      "id": "u0010p7",
      "start_s": 108.84,
      "end_s": 111.06,
      "text": "железа что классно"
    },
    {
      "id": "u0010p8",
      "start_s": 111.69,
      "end_s": 115.11,
      "text": "если в ваших вдруг задачах"
    },
    {
      "id": "u0010p9",
      "start_s": 115.29,
      "end_s": 116.06,
      "text": "данный"
    },
    {
      "id": "u0010p10",
      "start_s": 116.34,
      "end_s": 121.11,
      "text": "кейс интересен Можно во-первых... ...вызывать кодик такой себе за"
    },
    {
      "id": "u0010p11",
      "start_s": 121.24,
      "end_s": 121.76,
      "text": "буквально"
    },
    {
      "id": "u0010p12",
      "start_s": 121.99,
      "end_s": 124.41,
      "text": "пару дней там ничего сложного По"
    },
    {
      "id": "u0010p13",
      "start_s": 124.49,
      "end_s": 126.05,
      "text": "крайней мере если у вас Android"
    },
    {
      "id": "u0013p1",
      "start_s": 126.91,
      "end_s": 127.76,
      "text": "С цеплом"
    },
    {
      "id": "u0013p2",
      "start_s": 128.04,
      "end_s": 129.51,
      "text": "сложно"
    },
    {
      "id": "u0013p3",
      "start_s": 130.14,
      "end_s": 131.86,
      "text": "в App Store там у них какие-то гонские"
    },
    {
      "id": "u0013p4",
      "start_s": 131.94,
      "end_s": 133.11,
      "text": "подписки"
    },
    {
      "id": "u0013p5",
      "start_s": 134.09,
      "end_s": 139.66,
      "text": "год нужно платить просто за возможность выложить приложение Ну если Android то в целом вообще пофигу"
    },
    {
      "id": "u0013p6",
      "start_s": 139.94,
      "end_s": 141.31,
      "text": "собрали себе образ"
    },
    {
      "id": "u0013p7",
      "start_s": 141.34,
      "end_s": 142.49,
      "text": "и пользуйтесь"
    },
    {
      "id": "u0015p1",
      "start_s": 144.63,
      "end_s": 146.06,
      "text": "В общем если"
    },
    {
      "id": "u0015p2",
      "start_s": 146.64,
      "end_s": 148.31,
      "text": "юзеркейс то классно"
    },
    {
      "id": "u0016",
      "start_s": 149.95,
      "end_s": 153.06,
      "text": "Нет хуёвая подводка это мы убираем эту ветку"
    },
    {
      "id": "u0017",
      "start_s": 154.49,
      "end_s": 157.61,
      "text": "Чё я хотел сказать-то Ну вот я рассказал что как это классно"
    },
    {
      "id": "u0018p1",
      "start_s": 159.04,
      "end_s": 159.51,
      "text": "на"
    },
    {
      "id": "u0018p2",
      "start_s": 159.59,
      "end_s": 161.03,
      "text": "вайп-коде таки круто"
    },
    {
      "id": "u0019p1",
      "start_s": 165.81,
      "end_s": 166.46,
      "text": "В общем"
    },
    {
      "id": "u0019p2",
      "start_s": 168.54,
      "end_s": 174.01,
      "text": "продаж а исключительно под одного человека с одним..."
    },
    {
      "id": "u0020",
      "start_s": 177.01,
      "end_s": 177.65,
      "text": "Погоди-ка"
    },
    {
      "id": "u0021p1",
      "start_s": 178.93,
      "end_s": 184.96,
      "text": "В общем это решение не под какой-то отдел продаж большую компанию ну а как оно и было"
    },
    {
      "id": "u0021p2",
      "start_s": 185.84,
      "end_s": 190.76,
      "text": "конкретно под одного человека с конкретным телефоном Кто не хочет чтобы"
    },
    {
      "id": "u0021p3",
      "start_s": 191.44,
      "end_s": 196.39,
      "text": "утекали куда-либо для важных приватных звонков"
    }
  ],
