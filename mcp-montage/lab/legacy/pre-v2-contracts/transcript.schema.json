{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.video.factory/contracts/transcript.schema.json",
  "title": "Canonical Word-Level Transcript",
  "type": "object",
  "required": ["schema_version", "source_id", "duration_s", "segments", "words"],
  "properties": {
    "schema_version": {"const": 1},
    "source_id": {"type": "string"},
    "media_path": {"type": ["string", "null"]},
    "language": {"type": ["string", "null"]},
    "duration_s": {"type": "number", "minimum": 0},
    "segments": {"type": "array"},
    "words": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "segment_id", "start_s", "end_s", "text"],
        "properties": {
          "id": {"type": "string"},
          "segment_id": {"type": "string"},
          "start_s": {"type": "number", "minimum": 0},
          "end_s": {"type": "number", "minimum": 0},
          "text": {"type": "string"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    }
  },
  "additionalProperties": true
}

